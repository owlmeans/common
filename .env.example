BUILDER_PATH=/home/igor/projects/owlmeans/deployment/bun

# =============================================================================
# Integration test environment
# -----------------------------------------------------------------------------
# Variables below drive the env-gated integration tests in category-C
# packages (`postgres*`, `mongo*`, `redis*`, `kluster`, `storage*`,
# `image-resource`, `server-api`, `server-app`, `queue`).
#
# When a required variable is empty, the corresponding gate in
# `@owlmeans/test-integration` reports `skip: true`, the per-package
# `tests/context.ts` does NOT register that service, and any spec depending
# on it self-skips with the printed reason. So an empty variable means
# "no tests run for that service" — never a failure.
# =============================================================================

# --- MongoDB (used by @owlmeans/mongo, @owlmeans/mongo-resource) ---
# Full connection string. Required for the gate to open. The specs create and
# drop a randomly namespaced database per run.
#   kubectl port-forward svc/mongo-owlmeans-mongo-service 27017:27017
#   MONGO_URL=mongodb://<user>:<password>@127.0.0.1:27017/?authSource=admin&directConnection=true
# `directConnection=true` is what makes a single member of a replica set usable
# without server selection waiting for a primary it will never discover.
MONGO_URL=
# Optional prefix for randomly-namespaced test databases. Default: `omt`.
MONGO_TEST_DB_PREFIX=omt

# --- PostgreSQL (used by @owlmeans/postgres, @owlmeans/postgres-resource) ---
# Full connection string. Required for the gate to open. The role must be able to
# CREATE SCHEMA in the target database — the specs create and drop a randomly
# namespaced schema per run, never a database.
#   kubectl port-forward svc/postgres-owlmeans-postgres-service 5432:5432
#   POSTGRES_URL=postgres://<role>:<password>@127.0.0.1:5432/<database>
# The bootstrap specs additionally need CREATEROLE and CREATEDB; without them
# those specs self-skip while the rest of the suite still runs.
POSTGRES_URL=
# Optional prefix for randomly-namespaced test schemas. Default: `omt`.
POSTGRES_TEST_DB_PREFIX=omt

# --- Redis (used by @owlmeans/redis, @owlmeans/redis-resource, @owlmeans/server-auth) ---
# Required for the gate to open. The specs namespace every key by prefix and drop it on
# completion, so they are safe against a shared instance.
#   kubectl port-forward svc/cache-owlmeans-redis-service 16379:6379
#   REDIS_URL=redis://default:<url-escaped-password>@127.0.0.1:16379
# Pick a free local port — another checkout may already forward the default 6379.
REDIS_URL=
# Optional prefix for randomly-namespaced test keys. Default: `omt`.
REDIS_TEST_KEY_PREFIX=omt

# --- S3-compatible object storage (used by @owlmeans/storage-resource, @owlmeans/image-resource) ---
# All four are required for the gate to open.
S3_ENDPOINT=
S3_KEY=
S3_SECRET=
S3_TEST_BUCKET=
# Optional region. Default: `us-east-1` if empty.
S3_REGION=us-east-1

# --- Kubernetes (used by @owlmeans/kluster) ---
# Path to a kubeconfig file scoped to a DEDICATED test cluster.
KUBE_CONFIG=
# Confirmation flag — set to `1` to acknowledge that running these tests is
# safe against the cluster pointed at by KUBE_CONFIG. Without this flag the
# kube gate stays closed even when KUBE_CONFIG is populated.
KUBE_TEST_OK=

# --- LLM providers (used by @owlmeans/llm live specs) ---
# OpenAI-compatible aggregator (OpenRouter by default). Required for the
# `openrouter` gate to open.
OPENROUTER_SECRET=
# Optional base URL. Default: `https://openrouter.ai/api/v1`.
OPENROUTER_URL=
# Anthropic API key. Required for the `anthropic` gate to open.
ANTHROPIC_SECRET=

# --- SMTP (used by @owlmeans/mailer-smtp) ---
# The five below are all required for the gate to open. These specs send a REAL
# message through the configured relay on every run — leave them empty unless you
# want mail delivered.
#   Mailgun EU: SMTP_HOST=smtp.eu.mailgun.org, credentials from the domain's
#   SMTP settings (not the account login).
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# Default sender. The domain must be verified with the relay; the local part is free.
#   SMTP_FROM="OwlMeans <no-reply@example.com>"
SMTP_FROM=
# Mailbox the delivery spec sends to.
SMTP_TEST_TO=
# Optional. Default: 465 with implicit TLS. Use 587/2525 with SMTP_SECURE=false
# (STARTTLS), or 25 for an unauthenticated relay.
SMTP_PORT=465
SMTP_SECURE=true
