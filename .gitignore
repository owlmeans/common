# OS specific files
.DS_Store

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Dependency only configuration
yarn.lock
bun.lock

# Dependency directories
node_modules/

# Yarn Integrity file
.yarn-integrity

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Project specific build artifacts
/packages/*/build/*
!/packages/*/build/.gitkeep

# Prevent build artifacts from being committed inside src/
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
!packages/native-client/src/globals.d.ts

# Tmp files from dev containers
/tmp/*

# GitKeep
!.gitkeep

# Deployments
dev.values.yaml
.env

# Typescript
tsconfig.tsbuildinfo
