# OS specific files
.DS_Store

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Dependency only configuration
yarn.lock
bun.lock

# Dependency directories
node_modules/

# Yarn Integrity file
.yarn-integrity

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Project specific build artifacts
/packages/*/build/*
!/packages/*/build/.gitkeep

# Tmp files from dev containers
/tmp/*

# GitKeep
!.gitkeep

# Deployments
dev.values.yaml
.env

# Typescript
tsconfig.tsbuildinfo

# Playwright
test-results/
playwright-report/

# Test source tree must remain TypeScript only — `tsc -b -w` must not emit
# alongside *.spec.ts. Excludes set in each package's tsconfig.json prevent
# emission, but a stale `dev`/`watch` started before the exclude was added
# can still produce these. Belt-and-braces.
/packages/*/tests/**/*.js
/packages/*/tests/**/*.d.ts
/packages/*/tests/**/*.js.map
/packages/*/tests/**/*.d.ts.map
