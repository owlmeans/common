{
  "name": "@owlmeans/agent-skills",
  "version": "0.1.21",
  "license": "MIT",
  "homepage": "https://owlmeans.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlmeans/common.git",
    "directory": "packages/agent-skills"
  },
  "bugs": {
    "url": "https://github.com/owlmeans/common/issues"
  },
  "author": "Igor Tkachenko <igor.tkachenko@owlmeans.com> (https://owlmeans.com)",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "bin": {
    "owlmeans-agent-skills": "./build/bin.js"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./llm": {
      "import": "./build/llm/index.js",
      "require": "./build/llm/index.js",
      "default": "./build/llm/index.js",
      "module": "./build/llm/index.js",
      "types": "./build/llm/index.d.ts"
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.3.1",
    "@owlmeans/dep-config": "^0.1.21",
    "@owlmeans/llm": "^0.1.21",
    "@owlmeans/llm-common": "^0.1.21",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@owlmeans/llm": "^0.1.21",
    "@owlmeans/llm-common": "^0.1.21"
  },
  "peerDependenciesMeta": {
    "@owlmeans/llm": {
      "optional": true
    },
    "@owlmeans/llm-common": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
