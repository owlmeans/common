{
  "name": "@owlmeans/agent",
  "version": "0.1.18-rc.21",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 178 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./plugins": {
      "import": "./build/plugins/export.js",
      "require": "./build/plugins/export.js",
      "default": "./build/plugins/export.js",
      "module": "./build/plugins/export.js",
      "types": "./build/plugins/export.d.ts"
    },
    "./helpers": {
      "import": "./build/helpers/index.js",
      "require": "./build/helpers/index.js",
      "default": "./build/helpers/index.js",
      "module": "./build/helpers/index.js",
      "types": "./build/helpers/index.d.ts"
    },
    "./stores": {
      "import": "./build/stores/index.js",
      "require": "./build/stores/index.js",
      "default": "./build/stores/index.js",
      "module": "./build/stores/index.js",
      "types": "./build/stores/index.d.ts"
    },
    "./pipeline": {
      "import": "./build/pipeline/index.js",
      "require": "./build/pipeline/index.js",
      "default": "./build/pipeline/index.js",
      "module": "./build/pipeline/index.js",
      "types": "./build/pipeline/index.d.ts"
    },
    "./checkpoint": {
      "import": "./build/checkpoint/index.js",
      "require": "./build/checkpoint/index.js",
      "default": "./build/checkpoint/index.js",
      "module": "./build/checkpoint/index.js",
      "types": "./build/checkpoint/index.d.ts"
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@owlmeans/dep-config": "workspace:*",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.1.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2",
    "zod": "^4.1.0",
    "@langchain/langgraph-checkpoint": "^1.1.5"
  },
  "dependencies": {
    "@owlmeans/agent-common": "^0.1.18-rc.21",
    "@owlmeans/basic-ids": "^0.1.18-rc.14",
    "@owlmeans/context": "^0.1.18-rc.13",
    "@owlmeans/error": "^0.1.18-rc.13",
    "@owlmeans/flow": "^0.1.18-rc.19",
    "@owlmeans/llm": "^0.1.18-rc.18",
    "@owlmeans/llm-common": "^0.1.18-rc.17",
    "ajv": "^8.17.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint": "^1.1.5"
  }
}
