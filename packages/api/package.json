{
  "name": "@owlmeans/api",
  "version": "0.1.18-rc.46",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 0 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./status": {
      "import": "./build/status/index.js",
      "require": "./build/status/index.js",
      "default": "./build/status/index.js",
      "module": "./build/status/index.js",
      "types": "./build/status/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth-common": "^0.1.18-rc.46",
    "@owlmeans/client-config": "^0.1.18-rc.43",
    "@owlmeans/client-route": "^0.1.18-rc.47",
    "@owlmeans/config": "^0.1.18-rc.43",
    "@owlmeans/context": "^0.1.18-rc.33",
    "@owlmeans/entrypoint": "^0.1.18-rc.40",
    "@owlmeans/error": "^0.1.18-rc.37",
    "@owlmeans/log": "^0.1.18-rc.1",
    "@owlmeans/route": "^0.1.18-rc.34",
    "axios": "^1.20.0",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/resource": "^0.1.18-rc.39",
    "@types/qs": "^6.15.1",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
