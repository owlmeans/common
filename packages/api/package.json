{
  "name": "@owlmeans/api",
  "version": "0.1.20-rc.1",
  "license": "MIT",
  "homepage": "https://owlmeans.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlmeans/common.git",
    "directory": "packages/api"
  },
  "bugs": {
    "url": "https://github.com/owlmeans/common/issues"
  },
  "author": "Igor Tkachenko <igor.tkachenko@owlmeans.com> (https://owlmeans.com)",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 0 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./status": {
      "import": "./build/status/index.js",
      "require": "./build/status/index.js",
      "default": "./build/status/index.js",
      "module": "./build/status/index.js",
      "types": "./build/status/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth-common": "^0.1.20-rc.1",
    "@owlmeans/client-config": "^0.1.20-rc.1",
    "@owlmeans/client-route": "^0.1.20-rc.1",
    "@owlmeans/config": "^0.1.20-rc.1",
    "@owlmeans/context": "^0.1.20-rc.1",
    "@owlmeans/entrypoint": "^0.1.20-rc.1",
    "@owlmeans/error": "^0.1.20-rc.1",
    "@owlmeans/log": "^0.1.20-rc.1",
    "@owlmeans/route": "^0.1.20-rc.1",
    "axios": "^1.21.0",
    "qs": "^6.17.0"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "^0.1.20-rc.1",
    "@owlmeans/resource": "^0.1.20-rc.1",
    "@types/qs": "^6.15.1",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
