{
  "name": "@owlmeans/auth-common",
  "version": "0.1.3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 30 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./utils": {
      "import": "./build/utils/index.js",
      "require": "./build/utils/index.js",
      "default": "./build/utils/index.js",
      "module": "./build/utils/index.js",
      "types": "./build/utils/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth": "^0.1.3",
    "@owlmeans/auth-common": "^0.1.3",
    "@owlmeans/basic-ids": "^0.1.3",
    "@owlmeans/basic-keys": "^0.1.3",
    "@owlmeans/client-entrypoint": "^0.1.3",
    "@owlmeans/context": "^0.1.3",
    "@owlmeans/entrypoint": "^0.1.3",
    "@owlmeans/resource": "^0.1.3",
    "@owlmeans/route": "^0.1.3"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test-auth": "^0.1.2",
    "@types/bun": "^1.3.0",
    "nodemon": "^3.1.11",
    "npm-check": "^6.0.1",
    "typescript": "^6.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
