{
  "name": "@owlmeans/auth-email",
  "version": "0.1.20-alpha.0",
  "license": "MIT",
  "description": "Contracts of OwlMeans e-mail sign-in — PIN, optional password, remembered devices, captcha: the protocol factory, schemas, views, constants and errors.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 2 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth": "^0.1.19",
    "@owlmeans/auth-common": "0.1.20-alpha.0",
    "@owlmeans/context": "^0.1.19",
    "@owlmeans/entrypoint": "^0.1.19",
    "@owlmeans/error": "^0.1.19",
    "@owlmeans/route": "^0.1.19"
  },
  "peerDependencies": {
    "ajv": "*",
    "ajv-formats": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "^0.1.19",
    "@types/bun": "^1.4.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
