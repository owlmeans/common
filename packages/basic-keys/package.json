{
  "name": "@owlmeans/basic-keys",
  "version": "0.1.20-rc.1",
  "license": "MIT",
  "homepage": "https://owlmeans.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlmeans/common.git",
    "directory": "packages/basic-keys"
  },
  "bugs": {
    "url": "https://github.com/owlmeans/common/issues"
  },
  "author": "Igor Tkachenko <igor.tkachenko@owlmeans.com> (https://owlmeans.com)",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 48 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "bin": {
    "owlkeys": "build/bin.js"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./plugins": {
      "import": "./build/plugins/export.js",
      "require": "./build/plugins/export.js",
      "default": "./build/plugins/export.js",
      "module": "./build/plugins/export.js",
      "types": "./build/plugins/export.d.ts"
    },
    "./utils": {
      "import": "./build/utils.js",
      "require": "./build/utils.js",
      "default": "./build/utils.js",
      "module": "./build/utils.js",
      "types": "./build/utils.d.ts"
    }
  },
  "devDependencies": {
    "@owlmeans/dep-config": "^0.1.20-rc.1",
    "@owlmeans/test-auth": "^0.1.20-rc.1",
    "@types/bun": "^1.4.4",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@owlmeans/auth": "^0.1.20-rc.1",
    "@scure/base": "^2.4.0",
    "canonicalize": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
