{
  "name": "@owlmeans/bot-postgres",
  "version": "0.1.19-rc.0",
  "license": "MIT",
  "description": "Postgres-backed resources for @owlmeans/server-bot — the connection, inbox and activity tables of a generated target project, compiled from the shared AJV schemas, with the unique inbox dedupe key.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 14 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/context": "^0.1.19-rc.0",
    "@owlmeans/postgres-resource": "^0.1.19-rc.0",
    "@owlmeans/resource": "^0.1.19-rc.0",
    "@owlmeans/server-bot": "^0.1.19-rc.0"
  },
  "peerDependencies": {
    "ajv": "*",
    "pg": "*"
  },
  "devDependencies": {
    "@owlmeans/bot": "^0.1.19-rc.0",
    "@owlmeans/dep-config": "^0.1.19-rc.0",
    "@owlmeans/log": "^0.1.19-rc.0",
    "@owlmeans/postgres": "^0.1.19-rc.0",
    "@owlmeans/server-context": "^0.1.19-rc.0",
    "@owlmeans/test": "^0.1.19-rc.0",
    "@owlmeans/test-integration": "^0.1.19-rc.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "nodemon": "^3.1.14",
    "pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
