{
  "name": "@owlmeans/captcha",
  "version": "0.1.20-rc.1",
  "license": "MIT",
  "description": "Captcha verification for OwlMeans servers — the reCAPTCHA siteverify verifier, the policy of the re-captcha sign-in plugin, and a strict challenge-less check a route runs on a score-based token.",
  "homepage": "https://owlmeans.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlmeans/common.git",
    "directory": "packages/captcha"
  },
  "bugs": {
    "url": "https://github.com/owlmeans/common/issues"
  },
  "author": "Igor Tkachenko <igor.tkachenko@owlmeans.com> (https://owlmeans.com)",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 2 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth": "^0.1.20-rc.1",
    "@owlmeans/config": "^0.1.20-rc.1",
    "@owlmeans/context": "^0.1.20-rc.1",
    "@owlmeans/log": "^0.1.20-rc.1"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "^0.1.20-rc.1",
    "@types/bun": "^1.4.4",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
