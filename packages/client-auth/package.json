{
  "name": "@owlmeans/client-auth",
  "version": "0.1.17",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 66 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./manager": {
      "import": "./build/manager/index.js",
      "require": "./build/manager/index.js",
      "default": "./build/manager/index.js",
      "module": "./build/manager/index.js",
      "types": "./build/manager/index.d.ts"
    },
    "./manager/modules": {
      "import": "./build/manager/modules.js",
      "require": "./build/manager/modules.js",
      "default": "./build/manager/modules.js",
      "module": "./build/manager/modules.js",
      "types": "./build/manager/modules.d.ts"
    },
    "./manager/plugins": {
      "import": "./build/manager/plugins/exports.js",
      "require": "./build/manager/plugins/exports.js",
      "default": "./build/manager/plugins/exports.js",
      "module": "./build/manager/plugins/exports.js",
      "types": "./build/manager/plugins/exports.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth": "^0.1.17",
    "@owlmeans/auth-common": "^0.1.17",
    "@owlmeans/basic-envelope": "^0.1.17",
    "@owlmeans/basic-keys": "^0.1.17",
    "@owlmeans/client": "^0.1.17",
    "@owlmeans/client-context": "^0.1.17",
    "@owlmeans/client-flow": "^0.1.17",
    "@owlmeans/client-entrypoint": "^0.1.17",
    "@owlmeans/client-resource": "^0.1.17",
    "@owlmeans/client-socket": "^0.1.17",
    "@owlmeans/context": "^0.1.17",
    "@owlmeans/did": "^0.1.17",
    "@owlmeans/error": "^0.1.17",
    "@owlmeans/flow": "^0.1.17",
    "@owlmeans/entrypoint": "^0.1.17",
    "@owlmeans/resource": "^0.1.17",
    "@owlmeans/socket": "^0.1.17",
    "@owlmeans/web-flow": "^0.1.17",
    "@scure/base": "^2.3.0"
  },
  "peerDependencies": {
    "ajv": "*",
    "react": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test-auth": "^0.1.17",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
