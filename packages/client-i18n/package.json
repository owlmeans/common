{
  "name": "@owlmeans/client-i18n",
  "version": "0.1.19",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 96 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./utils": {
      "import": "./build/utils/index.js",
      "require": "./build/utils/index.js",
      "default": "./build/utils/index.js",
      "module": "./build/utils/index.js",
      "types": "./build/utils/index.d.ts"
    }
  },
  "peerDependencies": {
    "react": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "^0.1.19",
    "@types/react": "^19.3.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@owlmeans/client": "^0.1.19",
    "@owlmeans/client-context": "^0.1.19",
    "@owlmeans/i18n": "^0.1.19",
    "@owlmeans/log": "^0.1.19",
    "i18next": "^26.5.11",
    "react-i18next": "^17.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
