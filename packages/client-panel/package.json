{
  "name": "@owlmeans/client-panel",
  "version": "0.1.12",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 108 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./auth": {
      "import": "./build/auth/index.js",
      "require": "./build/auth/index.js",
      "default": "./build/auth/index.js",
      "module": "./build/auth/index.js",
      "types": "./build/auth/index.d.ts"
    },
    "./auth/plugins": {
      "import": "./build/auth/plugins/exports.js",
      "require": "./build/auth/plugins/exports.js",
      "default": "./build/auth/plugins/exports.js",
      "module": "./build/auth/plugins/exports.js",
      "types": "./build/auth/plugins/exports.d.ts"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@owlmeans/client": "^0.1.12",
    "@owlmeans/client-i18n": "^0.1.12",
    "@owlmeans/client-entrypoint": "^0.1.12",
    "@owlmeans/client-route": "^0.1.12",
    "@owlmeans/error": "^0.1.12",
    "@owlmeans/entrypoint": "^0.1.12"
  },
  "peerDependencies": {
    "@owlmeans/auth": "^0.1.12",
    "@owlmeans/client-auth": "^0.1.12",
    "@owlmeans/i18n": "^0.1.12",
    "@owlmeans/router": "^0.1.12",
    "ajv": "*",
    "react": "*",
    "react-hook-form": "*"
  },
  "peerDependenciesMeta": {
    "@owlmeans/auth": {
      "optional": true
    },
    "@owlmeans/client-auth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/auth": "^0.1.12",
    "@owlmeans/client-auth": "^0.1.12",
    "@types/react": "^19.2.17",
    "nodemon": "^3.1.14",
    "react-hook-form": "^7.53.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
