{
  "name": "@owlmeans/client-panel",
  "version": "0.1.20-rc.1",
  "license": "MIT",
  "homepage": "https://owlmeans.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlmeans/common.git",
    "directory": "packages/client-panel"
  },
  "bugs": {
    "url": "https://github.com/owlmeans/common/issues"
  },
  "author": "Igor Tkachenko <igor.tkachenko@owlmeans.com> (https://owlmeans.com)",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 108 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./auth": {
      "import": "./build/auth/index.js",
      "require": "./build/auth/index.js",
      "default": "./build/auth/index.js",
      "module": "./build/auth/index.js",
      "types": "./build/auth/index.d.ts"
    },
    "./auth/plugins": {
      "import": "./build/auth/plugins/exports.js",
      "require": "./build/auth/plugins/exports.js",
      "default": "./build/auth/plugins/exports.js",
      "module": "./build/auth/plugins/exports.js",
      "types": "./build/auth/plugins/exports.d.ts"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@owlmeans/client": "^0.1.20-rc.1",
    "@owlmeans/client-i18n": "^0.1.20-rc.1",
    "@owlmeans/client-entrypoint": "^0.1.20-rc.1",
    "@owlmeans/client-route": "^0.1.20-rc.1",
    "@owlmeans/error": "^0.1.20-rc.1",
    "@owlmeans/entrypoint": "^0.1.20-rc.1"
  },
  "peerDependencies": {
    "@owlmeans/auth": "^0.1.20-rc.1",
    "@owlmeans/client-auth": "^0.1.20-rc.1",
    "@owlmeans/config": "^0.1.20-rc.1",
    "@owlmeans/i18n": "^0.1.20-rc.1",
    "@owlmeans/router": "^0.1.20-rc.1",
    "ajv": "*",
    "react": "*",
    "react-hook-form": "*"
  },
  "peerDependenciesMeta": {
    "@owlmeans/auth": {
      "optional": true
    },
    "@owlmeans/client-auth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@owlmeans/dep-config": "^0.1.20-rc.1",
    "@owlmeans/auth": "^0.1.20-rc.1",
    "@owlmeans/client-auth": "^0.1.20-rc.1",
    "@types/react": "^19.3.0",
    "nodemon": "^3.1.14",
    "react-hook-form": "^7.91.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
