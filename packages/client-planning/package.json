{
  "name": "@owlmeans/client-planning",
  "version": "0.1.19",
  "license": "MIT",
  "description": "The client half of OwlMeans planning — the remote planning facade, the state mirror and its commit fold, and the subscribe-then-poll commit wait. React-free: it runs in a browser and in a Node client alike.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 10 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@owlmeans/auth": "^0.1.19",
    "@owlmeans/client-context": "^0.1.19",
    "@owlmeans/client-entrypoint": "^0.1.19",
    "@owlmeans/context": "^0.1.19",
    "@owlmeans/entrypoint": "^0.1.19",
    "@owlmeans/error": "^0.1.19",
    "@owlmeans/planning": "^0.1.19",
    "@owlmeans/resource": "^0.1.19",
    "@owlmeans/log": "^0.1.19",
    "@owlmeans/route": "^0.1.19",
    "@owlmeans/socket": "^0.1.19",
    "@owlmeans/state": "^0.1.19"
  },
  "peerDependencies": {
    "ajv": "*",
    "ajv-formats": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "^0.1.19",
    "@owlmeans/server-planning": "^0.1.19",
    "@owlmeans/test": "^0.1.19",
    "@types/bun": "^1.4.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
