{
  "name": "@owlmeans/client-socket",
  "version": "0.1.18-rc.8",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 132 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "peerDependencies": {
    "react": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@types/react": "^19.2.17",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@owlmeans/auth": "^0.1.18-rc.6",
    "@owlmeans/basic-envelope": "^0.1.18-rc.8",
    "@owlmeans/client": "^0.1.18-rc.9",
    "@owlmeans/client-context": "^0.1.18-rc.8",
    "@owlmeans/client-entrypoint": "^0.1.18-rc.8",
    "@owlmeans/context": "^0.1.18-rc.6",
    "@owlmeans/entrypoint": "^0.1.18-rc.7",
    "@owlmeans/socket": "^0.1.18-rc.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
