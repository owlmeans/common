{
  "name": "@owlmeans/client",
  "version": "0.1.18-rc.50",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 54 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./utils": {
      "import": "./build/utils/index.js",
      "require": "./build/utils/index.js",
      "default": "./build/utils/index.js",
      "module": "./build/utils/index.js",
      "types": "./build/utils/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth": "^0.1.18-rc.39",
    "@owlmeans/client-context": "^0.1.18-rc.47",
    "@owlmeans/client-entrypoint": "^0.1.18-rc.46",
    "@owlmeans/client-resource": "^0.1.18-rc.46",
    "@owlmeans/config": "^0.1.18-rc.43",
    "@owlmeans/context": "^0.1.18-rc.33",
    "@owlmeans/error": "^0.1.18-rc.37",
    "@owlmeans/entrypoint": "^0.1.18-rc.40",
    "@owlmeans/resource": "^0.1.18-rc.39",
    "@owlmeans/router": "^0.1.18-rc.32",
    "@owlmeans/state": "^0.1.18-rc.38"
  },
  "peerDependencies": {
    "@remix-run/router": "*",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "@remix-run/router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test-ui": "^0.1.18-rc.48",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "nodemon": "^3.1.14",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
