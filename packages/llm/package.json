{
  "name": "@owlmeans/llm",
  "version": "0.1.16",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 174 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./plugins": {
      "import": "./build/plugins/export.js",
      "require": "./build/plugins/export.js",
      "default": "./build/plugins/export.js",
      "module": "./build/plugins/export.js",
      "types": "./build/plugins/export.d.ts"
    },
    "./helpers": {
      "import": "./build/helpers/index.js",
      "require": "./build/helpers/index.js",
      "default": "./build/helpers/index.js",
      "module": "./build/helpers/index.js",
      "types": "./build/helpers/index.d.ts"
    },
    "./prompt": {
      "import": "./build/prompt/index.js",
      "require": "./build/prompt/index.js",
      "default": "./build/prompt/index.js",
      "module": "./build/prompt/index.js",
      "types": "./build/prompt/index.d.ts"
    }
  },
  "devDependencies": {
    "@langchain/anthropic": "^1.3.26",
    "@langchain/core": "^1.1.39",
    "@langchain/openai": "^1.4.4",
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test": "^0.1.16",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@owlmeans/basic-ids": "^0.1.16",
    "@owlmeans/context": "^0.1.16",
    "@owlmeans/error": "^0.1.16",
    "@owlmeans/llm-common": "^0.1.16",
    "ajv": "^8.17.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@langchain/anthropic": "^1.3.26",
    "@langchain/core": "^1.1.39",
    "@langchain/openai": "^1.4.4"
  }
}
