{
  "name": "@owlmeans/llm",
  "version": "0.2.0-alpha.1",
  "license": "MIT",
  "homepage": "https://owlmeans.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlmeans/common.git",
    "directory": "packages/llm"
  },
  "bugs": {
    "url": "https://github.com/owlmeans/common/issues"
  },
  "author": "Igor Tkachenko <igor.tkachenko@owlmeans.com> (https://owlmeans.com)",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 174 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./plugins": {
      "import": "./build/plugins/export.js",
      "require": "./build/plugins/export.js",
      "default": "./build/plugins/export.js",
      "module": "./build/plugins/export.js",
      "types": "./build/plugins/export.d.ts"
    },
    "./helpers": {
      "import": "./build/helpers/index.js",
      "require": "./build/helpers/index.js",
      "default": "./build/helpers/index.js",
      "module": "./build/helpers/index.js",
      "types": "./build/helpers/index.d.ts"
    },
    "./prompt": {
      "import": "./build/prompt/index.js",
      "require": "./build/prompt/index.js",
      "default": "./build/prompt/index.js",
      "module": "./build/prompt/index.js",
      "types": "./build/prompt/index.d.ts"
    },
    "./tokens": {
      "import": "./build/tokens/index.js",
      "require": "./build/tokens/index.js",
      "default": "./build/tokens/index.js",
      "module": "./build/tokens/index.js",
      "types": "./build/tokens/index.d.ts"
    }
  },
  "devDependencies": {
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.1",
    "@langchain/openai": "^1.8.0",
    "@owlmeans/dep-config": "^0.2.0-alpha.0",
    "@owlmeans/test": "^0.2.0-alpha.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@owlmeans/basic-ids": "^0.2.0-alpha.0",
    "@owlmeans/context": "^0.2.0-alpha.0",
    "@owlmeans/error": "^0.2.0-alpha.0",
    "@owlmeans/llm-common": "^0.2.0-alpha.1",
    "@owlmeans/log": "^0.2.0-alpha.0",
    "ajv": "^8.20.0",
    "@noble/hashes": "^2.4.0",
    "gpt-tokenizer": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.1",
    "@langchain/openai": "^1.8.0"
  }
}
