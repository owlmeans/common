{
  "name": "@owlmeans/mailer-smtp",
  "version": "0.1.18-rc.6",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 4 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/context": "^0.1.18-rc.6",
    "@owlmeans/mailer": "^0.1.18-rc.6",
    "@owlmeans/server-context": "^0.1.18-rc.6",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test": "^0.1.18-rc.6",
    "@owlmeans/test-integration": "^0.1.18-rc.6",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.1",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
