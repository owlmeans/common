{
  "name": "@owlmeans/marketing-consent-mongo",
  "version": "0.1.21",
  "license": "MIT",
  "description": "Mongo storage for @owlmeans/server-marketing-consent's two resources (marketing-consent-state, marketing-consent-log) — schemas imported, never duplicated. For the platform; generated target projects use @owlmeans/marketing-consent-postgres.",
  "homepage": "https://owlmeans.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlmeans/common.git",
    "directory": "packages/marketing-consent-mongo"
  },
  "bugs": {
    "url": "https://github.com/owlmeans/common/issues"
  },
  "author": "Igor Tkachenko <igor.tkachenko@owlmeans.com> (https://owlmeans.com)",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 2 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/context": "^0.1.21",
    "@owlmeans/marketing-consent": "^0.1.21",
    "@owlmeans/mongo-resource": "^0.1.21",
    "@owlmeans/resource": "^0.1.21",
    "@owlmeans/server-marketing-consent": "^0.1.21"
  },
  "peerDependencies": {
    "ajv": "*",
    "mongodb": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "^0.1.21",
    "@owlmeans/mongo": "^0.1.21",
    "@owlmeans/server-context": "^0.1.21",
    "@owlmeans/test": "^0.1.22-rc.0",
    "@owlmeans/test-integration": "^0.1.22-rc.0",
    "@types/bun": "^1.4.4",
    "ajv": "^8.20.0",
    "mongodb": "^7.7.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
