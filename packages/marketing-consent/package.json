{
  "name": "@owlmeans/marketing-consent",
  "version": "0.1.18-rc.5",
  "license": "MIT",
  "description": "Shared marketing-consent contracts — the standard opt-in/opt-out consent catalogue, revision-aware status resolution, terms acceptance and the guarded consent-surface protocol tree.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 2 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/context": "^0.1.18-rc.32",
    "@owlmeans/entrypoint": "^0.1.18-rc.37",
    "@owlmeans/route": "^0.1.18-rc.33",
    "@owlmeans/error": "^0.1.18-rc.36",
    "@owlmeans/i18n": "^0.1.18-rc.37"
  },
  "peerDependencies": {
    "ajv": "*",
    "ajv-formats": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test": "^0.1.18-rc.32",
    "@types/bun": "^1.4.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
