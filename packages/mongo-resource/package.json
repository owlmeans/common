{
  "name": "@owlmeans/mongo-resource",
  "version": "0.1.12",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 198 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "peerDependencies": {
    "ajv": "*",
    "mongodb": "*"
  },
  "dependencies": {
    "@owlmeans/context": "^0.1.12",
    "@owlmeans/resource": "^0.1.12",
    "@owlmeans/server-context": "^0.1.12"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test-integration": "^0.1.12",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "mongodb": "^6.9.0",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
