{
  "name": "@owlmeans/mongo",
  "version": "0.1.5",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 192 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@types/node": "^24.10.1",
    "nodemon": "^3.1.11",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "@owlmeans/basic-keys": "^0.1.5",
    "@owlmeans/context": "^0.1.5",
    "@owlmeans/mongo-resource": "^0.1.5",
    "@owlmeans/server-context": "^0.1.5",
    "@scure/base": "^1.1.9",
    "mongodb": "^6.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
