{
  "name": "@owlmeans/mui-oidc-rp",
  "version": "0.1.18-rc.30",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 378 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./auth/plugins": {
      "import": "./build/auth/plugins/index.js",
      "require": "./build/auth/plugins/index.js",
      "default": "./build/auth/plugins/index.js",
      "module": "./build/auth/plugins/index.js",
      "types": "./build/auth/plugins/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth": "^0.1.18-rc.15",
    "@owlmeans/basic-envelope": "^0.1.18-rc.18",
    "@owlmeans/client": "^0.1.18-rc.22",
    "@owlmeans/client-auth": "^0.1.18-rc.26",
    "@owlmeans/client-flow": "^0.1.18-rc.23",
    "@owlmeans/client-i18n": "^0.1.18-rc.21",
    "@owlmeans/context": "^0.1.18-rc.14",
    "@owlmeans/flow": "^0.1.18-rc.20",
    "@owlmeans/entrypoint": "^0.1.18-rc.17",
    "@owlmeans/oidc": "^0.1.18-rc.27",
    "@owlmeans/resource": "^0.1.18-rc.15",
    "@owlmeans/web-client": "^0.1.18-rc.30",
    "@owlmeans/web-flow": "^0.1.18-rc.23",
    "oidc-client-ts": "3.5.0"
  },
  "peerDependencies": {
    "@mui/material": "^7.*",
    "react": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test-auth": "^0.1.18-rc.19",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.17",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
