{
  "name": "@owlmeans/mui-oidc-rp",
  "version": "0.1.18-rc.13",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 378 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./auth/plugins": {
      "import": "./build/auth/plugins/index.js",
      "require": "./build/auth/plugins/index.js",
      "default": "./build/auth/plugins/index.js",
      "module": "./build/auth/plugins/index.js",
      "types": "./build/auth/plugins/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth": "^0.1.18-rc.6",
    "@owlmeans/basic-envelope": "^0.1.18-rc.8",
    "@owlmeans/client": "^0.1.18-rc.9",
    "@owlmeans/client-auth": "^0.1.18-rc.12",
    "@owlmeans/client-flow": "^0.1.18-rc.10",
    "@owlmeans/client-i18n": "^0.1.18-rc.8",
    "@owlmeans/context": "^0.1.18-rc.6",
    "@owlmeans/flow": "^0.1.18-rc.9",
    "@owlmeans/entrypoint": "^0.1.18-rc.7",
    "@owlmeans/oidc": "^0.1.18-rc.8",
    "@owlmeans/resource": "^0.1.18-rc.7",
    "@owlmeans/web-client": "^0.1.18-rc.13",
    "@owlmeans/web-flow": "^0.1.18-rc.10",
    "oidc-client-ts": "3.5.0"
  },
  "peerDependencies": {
    "@mui/material": "^7.*",
    "react": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test-auth": "^0.1.18-rc.8",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
