{
  "name": "@owlmeans/payment",
  "version": "0.1.18-rc.29",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 228 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./utils": {
      "import": "./build/utils/index.js",
      "require": "./build/utils/index.js",
      "default": "./build/utils/index.js",
      "module": "./build/utils/index.js",
      "types": "./build/utils/index.d.ts"
    }
  },
  "peerDependencies": {
    "ajv": "*"
  },
  "dependencies": {
    "@owlmeans/api-config": "^0.1.18-rc.28",
    "@owlmeans/auth": "^0.1.18-rc.27",
    "@owlmeans/basic-envelope": "^0.1.18-rc.28",
    "@owlmeans/config": "^0.1.18-rc.29",
    "@owlmeans/context": "^0.1.18-rc.25",
    "@owlmeans/error": "^0.1.18-rc.27",
    "@owlmeans/i18n": "^0.1.18-rc.28",
    "@owlmeans/entrypoint": "^0.1.18-rc.28",
    "@owlmeans/resource": "^0.1.18-rc.27",
    "@owlmeans/route": "^0.1.18-rc.26"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
