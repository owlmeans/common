{
  "name": "@owlmeans/planning-postgres",
  "version": "0.1.18-rc.23",
  "license": "MIT",
  "description": "A durable Postgres PlanningStore with eight native resources, card folds and versioned auxiliary writes in organization transactions, scoped schemas, recovery and a LISTEN/NOTIFY commit bus.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 12 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/basic-ids": "^0.1.18-rc.42",
    "@owlmeans/context": "^0.1.18-rc.35",
    "@owlmeans/error": "^0.1.18-rc.39",
    "@owlmeans/planning": "^0.1.18-rc.32",
    "@owlmeans/postgres-resource": "^0.1.18-rc.50",
    "@owlmeans/resource": "^0.1.18-rc.41",
    "@owlmeans/server-planning": "^0.1.18-rc.39",
    "@owlmeans/log": "^0.1.18-rc.4"
  },
  "peerDependencies": {
    "ajv": "*",
    "ajv-formats": "*",
    "pg": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/postgres": "^0.1.18-rc.52",
    "@owlmeans/server-context": "^0.1.18-rc.45",
    "@owlmeans/test": "^0.1.18-rc.39",
    "@owlmeans/test-integration": "^0.1.18-rc.37",
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "nodemon": "^3.1.14",
    "pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
