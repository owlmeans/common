    "@owlmeans/server-context": "^0.1.18-rc.44",
    "@owlmeans/log": "^0.1.18-rc.3",
    "drizzle-orm": "~0.45.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test-integration": "^0.1.18-rc.34",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
