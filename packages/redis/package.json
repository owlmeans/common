{
  "name": "@owlmeans/redis",
  "version": "0.1.18-rc.9",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 240 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test-integration": "^0.1.18-rc.6",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.1.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "@owlmeans/context": "^0.1.18-rc.6",
    "@owlmeans/redis-resource": "^0.1.18-rc.8",
    "@owlmeans/resource": "^0.1.18-rc.7",
    "@owlmeans/server-context": "^0.1.18-rc.8",
    "@scure/base": "^2.3.0",
    "ioredis": "^5.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
