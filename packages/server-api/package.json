  "license": "MIT",
  "homepage": "https://owlmeans.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlmeans/common.git",
    "directory": "packages/server-api"
  },
  "bugs": {
    "url": "https://github.com/owlmeans/common/issues"
  },
  "author": "Igor Tkachenko <igor.tkachenko@owlmeans.com> (https://owlmeans.com)",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 264 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./utils": {
      "import": "./build/utils/index.js",
      "require": "./build/utils/index.js",
      "default": "./build/utils/index.js",
      "module": "./build/utils/index.js",
      "types": "./build/utils/index.d.ts"
    }
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/middie": "^9.3.6",
    "@fastify/multipart": "^10.1.6",
    "@owlmeans/api": "^0.1.22-rc.0",
    "@owlmeans/auth": "^0.1.21",
    "@owlmeans/auth-common": "^0.1.22-rc.0",
    "@owlmeans/context": "^0.1.21",
    "@owlmeans/entrypoint": "^0.1.22-rc.0",
    "@owlmeans/error": "^0.1.21",
    "@owlmeans/log": "^0.1.21",
    "@owlmeans/route": "^0.1.22-rc.0",
    "@owlmeans/server-context": "^0.1.22-rc.0",
    "@owlmeans/server-entrypoint": "^0.1.22-rc.0",
    "ajv-errors": "^3.0.0",
    "fastify": "^5.12.7",
    "fastify-raw-body": "^6.0.3",
    "pino-pretty": "^13.2.0"
  },
  "peerDependencies": {
    "ajv": "*",
    "ajv-formats": "*"
  },
  "devDependencies": {
    "@owlmeans/client-context": "^0.1.22-rc.0",
    "@owlmeans/client-entrypoint": "^0.1.22-rc.0",
    "@owlmeans/dep-config": "^0.1.21",
    "@owlmeans/resource": "^0.1.21",
    "@owlmeans/test-auth": "^0.1.22-rc.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
