{
  "name": "@owlmeans/server-api",
  "version": "0.1.15",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 264 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./utils": {
      "import": "./build/utils/index.js",
      "require": "./build/utils/index.js",
      "default": "./build/utils/index.js",
      "module": "./build/utils/index.js",
      "types": "./build/utils/index.d.ts"
    }
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/middie": "^9.0.2",
    "@fastify/multipart": "^9.0.1",
    "@owlmeans/api": "^0.1.15",
    "@owlmeans/auth": "^0.1.15",
    "@owlmeans/auth-common": "^0.1.15",
    "@owlmeans/context": "^0.1.15",
    "@owlmeans/error": "^0.1.15",
    "@owlmeans/entrypoint": "^0.1.15",
    "@owlmeans/route": "^0.1.15",
    "@owlmeans/server-context": "^0.1.15",
    "@owlmeans/server-entrypoint": "^0.1.15",
    "ajv-errors": "^3.0.0",
    "fastify": "^5.0.0",
    "fastify-raw-body": "^5.0.0",
    "pino-pretty": "^13.0.0"
  },
  "peerDependencies": {
    "ajv": "*",
    "ajv-formats": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@types/node": "^26.1.0",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
