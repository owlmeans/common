{
  "name": "@owlmeans/server-app",
  "version": "0.1.18-rc.53",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 270 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/api": "^0.1.18-rc.48",
    "@owlmeans/client-config": "^0.1.18-rc.44",
    "@owlmeans/client-entrypoint": "^0.1.18-rc.48",
    "@owlmeans/config": "^0.1.18-rc.44",
    "@owlmeans/context": "^0.1.18-rc.34",
    "@owlmeans/kluster": "^0.1.18-rc.43",
    "@owlmeans/entrypoint": "^0.1.18-rc.41",
    "@owlmeans/route": "^0.1.18-rc.35",
    "@owlmeans/server-api": "^0.1.18-rc.52",
    "@owlmeans/server-auth": "^0.1.18-rc.55",
    "@owlmeans/server-context": "^0.1.18-rc.43",
    "@owlmeans/server-entrypoint": "^0.1.18-rc.40",
    "@owlmeans/server-route": "^0.1.18-rc.34",
    "@owlmeans/server-socket": "^0.1.18-rc.55",
    "@owlmeans/static-resource": "^0.1.18-rc.39"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@types/node": "^26.6.4",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
