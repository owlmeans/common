{
  "name": "@owlmeans/server-auth",
  "version": "0.1.16",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 276 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./manager": {
      "import": "./build/manager/index.js",
      "require": "./build/manager/index.js",
      "default": "./build/manager/index.js",
      "module": "./build/manager/index.js",
      "types": "./build/manager/index.d.ts"
    },
    "./manager/plugins": {
      "import": "./build/manager/plugins/export.js",
      "require": "./build/manager/plugins/export.js",
      "default": "./build/manager/plugins/export.js",
      "module": "./build/manager/plugins/export.js",
      "types": "./build/manager/plugins/export.d.ts"
    }
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "@owlmeans/api": "^0.1.16",
    "@owlmeans/api-config-server": "^0.1.16",
    "@owlmeans/auth": "^0.1.16",
    "@owlmeans/auth-common": "^0.1.16",
    "@owlmeans/basic-envelope": "^0.1.16",
    "@owlmeans/basic-ids": "^0.1.16",
    "@owlmeans/basic-keys": "^0.1.16",
    "@owlmeans/client-config": "^0.1.16",
    "@owlmeans/client-entrypoint": "^0.1.16",
    "@owlmeans/config": "^0.1.16",
    "@owlmeans/context": "^0.1.16",
    "@owlmeans/kluster": "^0.1.16",
    "@owlmeans/entrypoint": "^0.1.16",
    "@owlmeans/redis-resource": "^0.1.16",
    "@owlmeans/resource": "^0.1.16",
    "@owlmeans/route": "^0.1.16",
    "@owlmeans/server-api": "^0.1.16",
    "@owlmeans/server-context": "^0.1.16",
    "@owlmeans/server-entrypoint": "^0.1.16",
    "@owlmeans/server-route": "^0.1.16",
    "@owlmeans/server-socket": "^0.1.16",
    "@owlmeans/socket": "^0.1.16",
    "@owlmeans/static-resource": "^0.1.16",
    "@scure/base": "^2.3.0"
  },
  "peerDependencies": {
    "ajv": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test-auth": "^0.1.16",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
