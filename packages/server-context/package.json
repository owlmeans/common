{
  "name": "@owlmeans/server-context",
  "version": "0.1.16",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 288 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./utils": {
      "import": "./build/utils/index.js",
      "require": "./build/utils/index.js",
      "default": "./build/utils/index.js",
      "module": "./build/utils/index.js",
      "types": "./build/utils/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/client-config": "^0.1.16",
    "@owlmeans/config": "^0.1.16",
    "@owlmeans/context": "^0.1.16",
    "@owlmeans/route": "^0.1.16",
    "@owlmeans/server-config": "^0.1.16"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@types/node": "^26.1.0",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
