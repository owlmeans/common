{
  "name": "@owlmeans/server-entrypoint",
  "version": "0.1.18-rc.11",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 300 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/context": "^0.1.18-rc.8",
    "@owlmeans/entrypoint": "^0.1.18-rc.11",
    "@owlmeans/route": "^0.1.18-rc.9",
    "@owlmeans/server-route": "^0.1.18-rc.9"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@types/node": "^26.1.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
