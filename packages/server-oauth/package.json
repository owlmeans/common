{
  "name": "@owlmeans/server-oauth",
  "version": "0.1.21",
  "license": "MIT",
  "description": "The server half of @owlmeans/oauth — a standards-facing OAuth 2.1 authorization server (device authorization + authorization code with PKCE, RFC 9728/8414 metadata, Client ID Metadata Documents, Dynamic Client Registration) that mints ordinary @owlmeans/auth-token access tokens on approval.",
  "homepage": "https://owlmeans.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlmeans/common.git",
    "directory": "packages/server-oauth"
  },
  "bugs": {
    "url": "https://github.com/owlmeans/common/issues"
  },
  "author": "Igor Tkachenko <igor.tkachenko@owlmeans.com> (https://owlmeans.com)",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 2 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth": "^0.1.21",
    "@owlmeans/auth-common": "^0.1.21",
    "@owlmeans/auth-token": "^0.1.21",
    "@owlmeans/config": "^0.1.21",
    "@owlmeans/context": "^0.1.21",
    "@owlmeans/entrypoint": "^0.1.21",
    "@owlmeans/error": "^0.1.21",
    "@owlmeans/mongo-resource": "^0.1.21",
    "@owlmeans/oauth": "^0.1.21",
    "@owlmeans/resource": "^0.1.21",
    "@owlmeans/route": "^0.1.21",
    "@owlmeans/server-api": "^0.1.21",
    "@owlmeans/server-auth-token": "^0.1.21",
    "@owlmeans/server-context": "^0.1.21",
    "@owlmeans/static-resource": "^0.1.21"
  },
  "peerDependencies": {
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "^0.1.21",
    "@owlmeans/redis-resource": "^0.1.21",
    "@owlmeans/server-auth-identity": "^0.1.21",
    "@types/bun": "^1.4.4",
    "ajv": "^8.20.0",
    "fastify": "^5.12.7",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
