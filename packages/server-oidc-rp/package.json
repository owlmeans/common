{
  "name": "@owlmeans/server-oidc-rp",
  "version": "0.1.18-rc.58",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 312 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./auth/plugins": {
      "import": "./build/auth/plugins/index.js",
      "require": "./build/auth/plugins/index.js",
      "default": "./build/auth/plugins/index.js",
      "module": "./build/auth/plugins/index.js",
      "types": "./build/auth/plugins/index.d.ts"
    },
    "./auth": {
      "import": "./build/auth/index.js",
      "require": "./build/auth/index.js",
      "default": "./build/auth/index.js",
      "module": "./build/auth/index.js",
      "types": "./build/auth/index.d.ts"
    }
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test-auth": "^0.1.18-rc.48",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@owlmeans/auth": "^0.1.18-rc.41",
    "@owlmeans/auth-common": "^0.1.18-rc.49",
    "@owlmeans/basic-envelope": "^0.1.18-rc.48",
    "@owlmeans/client-entrypoint": "^0.1.18-rc.49",
    "@owlmeans/config": "^0.1.18-rc.44",
    "@owlmeans/context": "^0.1.18-rc.34",
    "@owlmeans/did": "^0.1.18-rc.49",
    "@owlmeans/entrypoint": "^0.1.18-rc.41",
    "@owlmeans/log": "^0.1.18-rc.3",
    "@owlmeans/oidc": "^0.1.18-rc.57",
    "@owlmeans/resource": "^0.1.18-rc.40",
    "@owlmeans/route": "^0.1.18-rc.35",
    "@owlmeans/server-api": "^0.1.18-rc.53",
    "@owlmeans/server-auth": "^0.1.18-rc.57",
    "@owlmeans/server-auth-session": "^0.1.18-rc.19",
    "@owlmeans/server-context": "^0.1.18-rc.44",
    "@owlmeans/server-entrypoint": "^0.1.18-rc.40",
    "@scure/base": "^2.4.0",
    "dayjs": "^1.11.23",
    "jose": "6.2.12",
    "openid-client": "6.8.8"
  },
  "peerDependencies": {
    "ajv": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
