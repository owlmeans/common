{
  "name": "@owlmeans/server-oidc-rp",
  "version": "0.1.3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 312 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./auth/plugins": {
      "import": "./build/auth/plugins/index.js",
      "require": "./build/auth/plugins/index.js",
      "default": "./build/auth/plugins/index.js",
      "module": "./build/auth/plugins/index.js",
      "types": "./build/auth/plugins/index.d.ts"
    },
    "./auth": {
      "import": "./build/auth/index.js",
      "require": "./build/auth/index.js",
      "default": "./build/auth/index.js",
      "module": "./build/auth/index.js",
      "types": "./build/auth/index.d.ts"
    }
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test-auth": "^0.1.2",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.10.1",
    "nodemon": "^3.1.11",
    "npm-check": "^6.0.1",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "@owlmeans/auth": "^0.1.3",
    "@owlmeans/auth-common": "^0.1.3",
    "@owlmeans/basic-envelope": "^0.1.3",
    "@owlmeans/client-entrypoint": "^0.1.3",
    "@owlmeans/config": "^0.1.3",
    "@owlmeans/context": "^0.1.3",
    "@owlmeans/did": "^0.1.3",
    "@owlmeans/entrypoint": "^0.1.3",
    "@owlmeans/oidc": "^0.1.3",
    "@owlmeans/resource": "^0.1.3",
    "@owlmeans/route": "^0.1.3",
    "@owlmeans/server-api": "^0.1.3",
    "@owlmeans/server-auth": "^0.1.3",
    "@owlmeans/server-context": "^0.1.3",
    "@owlmeans/server-entrypoint": "^0.1.3",
    "@scure/base": "^1.1.9",
    "dayjs": "^1.11.13",
    "jose": "6.2.3",
    "openid-client": "6.8.4"
  },
  "peerDependencies": {
    "ajv": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
