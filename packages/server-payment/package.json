{
  "name": "@owlmeans/server-payment",
  "version": "0.1.18-rc.17",
  "license": "MIT",
  "description": "Protocol-bound payment resources, entitlement gates, and Stripe checkout for OwlMeans servers.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 12 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "peerDependencies": {
    "ajv": "*"
  },
  "dependencies": {
    "@owlmeans/auth": "^0.1.18-rc.31",
    "@owlmeans/config": "^0.1.18-rc.33",
    "@owlmeans/context": "^0.1.18-rc.29",
    "@owlmeans/entrypoint": "^0.1.18-rc.32",
    "@owlmeans/iam": "^0.1.18-rc.36",
    "@owlmeans/mongo-resource": "^0.1.18-rc.32",
    "@owlmeans/payment": "^0.1.18-rc.34",
    "@owlmeans/resource": "^0.1.18-rc.31",
    "@owlmeans/route": "^0.1.18-rc.30",
    "@owlmeans/server-api": "^0.1.18-rc.37",
    "@owlmeans/server-app": "^0.1.18-rc.38",
    "@owlmeans/server-context": "^0.1.18-rc.32",
    "@owlmeans/server-entrypoint": "^0.1.18-rc.31",
    "async-mutex": "^0.5.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/mongo": "^0.1.18-rc.31",
    "@owlmeans/test-integration": "^0.1.18-rc.26",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.1.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
