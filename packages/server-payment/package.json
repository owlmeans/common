{
  "name": "@owlmeans/server-payment",
  "version": "0.1.18-rc.32",
  "license": "MIT",
  "description": "Protocol-bound payment resources, entitlement gates, and Stripe checkout for OwlMeans servers.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 12 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "peerDependencies": {
    "ajv": "*"
  },
  "dependencies": {
    "@owlmeans/auth": "^0.1.18-rc.40",
    "@owlmeans/config": "^0.1.18-rc.44",
    "@owlmeans/context": "^0.1.18-rc.34",
    "@owlmeans/entrypoint": "^0.1.18-rc.41",
    "@owlmeans/iam": "^0.1.18-rc.51",
    "@owlmeans/mailer": "^0.1.18-rc.36",
    "@owlmeans/mongo-resource": "^0.1.18-rc.43",
    "@owlmeans/payment": "^0.1.18-rc.49",
    "@owlmeans/resource": "^0.1.18-rc.40",
    "@owlmeans/log": "^0.1.18-rc.2",
    "@owlmeans/route": "^0.1.18-rc.35",
    "@owlmeans/server-api": "^0.1.18-rc.52",
    "@owlmeans/server-app": "^0.1.18-rc.53",
    "@owlmeans/server-context": "^0.1.18-rc.43",
    "@owlmeans/server-entrypoint": "^0.1.18-rc.40",
    "async-mutex": "^0.5.0",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/mongo": "^0.1.18-rc.46",
    "@owlmeans/test-integration": "^0.1.18-rc.33",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
