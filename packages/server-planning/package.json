{
  "name": "@owlmeans/server-planning",
  "version": "0.1.18-rc.11",
  "license": "MIT",
  "description": "The general planning implementation — the planning service and its plugin/middleware registry, the transition executor, the in-memory store, the protocol handlers and the commit feed.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 6 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./store": {
      "import": "./build/store/index.js",
      "require": "./build/store/index.js",
      "default": "./build/store/index.js",
      "module": "./build/store/index.js",
      "types": "./build/store/index.d.ts"
    },
    "./queue": {
      "import": "./build/queue/index.js",
      "require": "./build/queue/index.js",
      "default": "./build/queue/index.js",
      "module": "./build/queue/index.js",
      "types": "./build/queue/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth": "^0.1.18-rc.36",
    "@owlmeans/auth-common": "^0.1.18-rc.38",
    "@owlmeans/basic-ids": "^0.1.18-rc.33",
    "@owlmeans/context": "^0.1.18-rc.32",
    "@owlmeans/entrypoint": "^0.1.18-rc.37",
    "@owlmeans/error": "^0.1.18-rc.36",
    "@owlmeans/planning": "^0.1.18-rc.10",
    "@owlmeans/queue": "^0.1.18-rc.32",
    "@owlmeans/resource": "^0.1.18-rc.36",
    "@owlmeans/route": "^0.1.18-rc.33",
    "@owlmeans/server-api": "^0.1.18-rc.42",
    "@owlmeans/server-context": "^0.1.18-rc.37",
    "@owlmeans/server-entrypoint": "^0.1.18-rc.36",
    "@owlmeans/server-socket": "^0.1.18-rc.45",
    "@owlmeans/socket": "^0.1.18-rc.34"
  },
  "peerDependencies": {
    "ajv": "*",
    "ajv-formats": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test": "^0.1.18-rc.32",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
