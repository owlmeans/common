{
  "name": "@owlmeans/server-planning",
  "version": "0.1.21",
  "license": "MIT",
  "description": "The general planning implementation — the planning service and its plugin/middleware registry, the transition executor, the in-memory store, the protocol handlers and the commit feed.",
  "homepage": "https://owlmeans.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlmeans/common.git",
    "directory": "packages/server-planning"
  },
  "bugs": {
    "url": "https://github.com/owlmeans/common/issues"
  },
  "author": "Igor Tkachenko <igor.tkachenko@owlmeans.com> (https://owlmeans.com)",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 6 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./store": {
      "import": "./build/store/index.js",
      "require": "./build/store/index.js",
      "default": "./build/store/index.js",
      "module": "./build/store/index.js",
      "types": "./build/store/index.d.ts"
    },
    "./queue": {
      "import": "./build/queue/index.js",
      "require": "./build/queue/index.js",
      "default": "./build/queue/index.js",
      "module": "./build/queue/index.js",
      "types": "./build/queue/index.d.ts"
    },
    "./conformance": {
      "import": "./build/conformance/index.js",
      "require": "./build/conformance/index.js",
      "default": "./build/conformance/index.js",
      "module": "./build/conformance/index.js",
      "types": "./build/conformance/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth": "^0.1.21",
    "@owlmeans/auth-common": "^0.1.21",
    "@owlmeans/basic-ids": "^0.1.21",
    "@owlmeans/context": "^0.1.21",
    "@owlmeans/entrypoint": "^0.1.21",
    "@owlmeans/error": "^0.1.21",
    "@owlmeans/planning": "^0.1.21",
    "@owlmeans/queue": "^0.1.21",
    "@owlmeans/resource": "^0.1.21",
    "@owlmeans/log": "^0.1.21",
    "@owlmeans/route": "^0.1.21",
    "@owlmeans/server-api": "^0.1.21",
    "@owlmeans/server-context": "^0.1.21",
    "@owlmeans/server-entrypoint": "^0.1.21",
    "@owlmeans/server-socket": "^0.1.21",
    "@owlmeans/socket": "^0.1.21"
  },
  "peerDependencies": {
    "ajv": "*",
    "ajv-formats": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "^0.1.21",
    "@owlmeans/test": "^0.1.21",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
