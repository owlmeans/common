{
  "name": "@owlmeans/server-upload",
  "version": "0.1.22-rc.0",
  "description": "Server-side uploads: sessions with limits counted on the expanded set and enforced atomically across parallel requests, files spooled to a scoped workspace and verified before they move (type mismatch, executables, active content refused and logged), archives unpacked with guards and their entries verified, accepted files handed to a receiver (a tree, or another service over a streamed route), and HTTP handlers for the upload protocol tree.",
  "license": "MIT",
  "homepage": "https://owlmeans.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlmeans/common.git",
    "directory": "packages/server-upload"
  },
  "bugs": {
    "url": "https://github.com/owlmeans/common/issues"
  },
  "author": "Igor Tkachenko <igor.tkachenko@owlmeans.com> (https://owlmeans.com)",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 401 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth-common": "^0.1.22-rc.0",
    "@owlmeans/context": "^0.1.21",
    "@owlmeans/entrypoint": "^0.1.22-rc.0",
    "@owlmeans/file-inspector": "^0.1.22-rc.0",
    "@owlmeans/file-streams": "^0.1.22-rc.0",
    "@owlmeans/log": "^0.1.21",
    "@owlmeans/resource": "^0.1.21",
    "@owlmeans/server-api": "^0.1.22-rc.0",
    "@owlmeans/server-entrypoint": "^0.1.22-rc.0",
    "@owlmeans/storage-common": "^0.1.22-rc.0",
    "@owlmeans/upload": "^0.1.22-rc.0"
  },
  "devDependencies": {
    "@owlmeans/api": "^0.1.22-rc.0",
    "@owlmeans/client-context": "^0.1.22-rc.0",
    "@owlmeans/client-entrypoint": "^0.1.22-rc.0",
    "@owlmeans/dep-config": "^0.1.21",
    "@owlmeans/route": "^0.1.22-rc.0",
    "@owlmeans/server-context": "^0.1.22-rc.0",
    "@owlmeans/static-resource": "^0.1.21",
    "@owlmeans/test-auth": "^0.1.22-rc.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
