{
  "name": "@owlmeans/storage-resource",
  "version": "0.1.16",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 393 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "peerDependencies": {
    "react": "*"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.701.0",
    "@owlmeans/context": "^0.1.16",
    "@owlmeans/error": "^0.1.16",
    "@owlmeans/resource": "^0.1.16",
    "@owlmeans/server-context": "^0.1.16",
    "@owlmeans/storage-common": "^0.1.16",
    "file-type": "^22.0.1"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@types/node": "^26.1.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
