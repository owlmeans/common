{
  "name": "@owlmeans/test-ui",
  "version": "0.1.18-rc.50",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./harness": "./harness/index.html"
  },
  "dependencies": {
    "@owlmeans/auth": "^0.1.18-rc.40",
    "@owlmeans/basic-envelope": "^0.1.18-rc.47",
    "@owlmeans/basic-ids": "^0.1.18-rc.38",
    "@owlmeans/basic-keys": "^0.1.18-rc.49",
    "@owlmeans/test": "^0.1.18-rc.35",
    "@owlmeans/test-auth": "^0.1.18-rc.47",
    "playwright": "^1.63.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@owlmeans/dep-config": "^0.1.18-rc.6",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
