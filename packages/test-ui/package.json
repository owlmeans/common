  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./harness": "./harness/index.html"
  },
  "dependencies": {
    "@owlmeans/auth": "^0.1.21",
    "@owlmeans/auth-common": "^0.1.22-rc.0",
    "@owlmeans/auth-email": "^0.1.22-rc.0",
    "@owlmeans/basic-envelope": "^0.1.22-rc.0",
    "@owlmeans/basic-ids": "^0.1.21",
    "@owlmeans/basic-keys": "^0.1.22-rc.0",
    "@owlmeans/test": "^0.1.22-rc.0",
    "@owlmeans/test-auth": "^0.1.22-rc.0",
    "playwright": "^1.64.1"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@owlmeans/context": "^0.1.21",
