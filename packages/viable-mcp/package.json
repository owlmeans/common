{
  "name": "@owlmeans/viable-mcp",
  "version": "0.1.18-rc.44",
  "license": "MIT",
  "description": "An MCP server that lets Claude Code, Codex, Copilot or OpenCode build full-stack web applications with the OwlMeans Viable platform.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 2 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "bin": {
    "viable-mcp": "./build/bin.js"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "files": [
    "build",
    "agent-meta"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@owlmeans/cli-auth": "^0.1.18-rc.15",
    "@owlmeans/oauth": "^0.1.18-rc.15",
    "@owlmeans/viable-common": "^0.0.44",
    "@owlmeans/viable-sdk": "^0.1.18-rc.44",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
