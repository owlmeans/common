{
  "name": "@owlmeans/viable-sdk",
  "version": "0.2.0-alpha.2",
  "license": "MIT",
  "description": "Drive the OwlMeans Viable platform from outside it — the connector session, the local slot executor, the tool catalogue and the model-task protocol an external coding agent answers.",
  "homepage": "https://owlmeans.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlmeans/common.git",
    "directory": "packages/viable-sdk"
  },
  "bugs": {
    "url": "https://github.com/owlmeans/common/issues"
  },
  "author": "Igor Tkachenko <igor.tkachenko@owlmeans.com> (https://owlmeans.com)",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 2 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./executor": {
      "import": "./build/executor/index.js",
      "require": "./build/executor/index.js",
      "default": "./build/executor/index.js",
      "module": "./build/executor/index.js",
      "types": "./build/executor/index.d.ts"
    },
    "./tools": {
      "import": "./build/tools/index.js",
      "require": "./build/tools/index.js",
      "default": "./build/tools/index.js",
      "module": "./build/tools/index.js",
      "types": "./build/tools/index.d.ts"
    },
    "./task": {
      "import": "./build/task/index.js",
      "require": "./build/task/index.js",
      "default": "./build/task/index.js",
      "module": "./build/task/index.js",
      "types": "./build/task/index.d.ts"
    },
    "./run": {
      "import": "./build/run/index.js",
      "require": "./build/run/index.js",
      "default": "./build/run/index.js",
      "module": "./build/run/index.js",
      "types": "./build/run/index.d.ts"
    }
  },
  "files": [
    "build",
    "agent-meta"
  ],
  "dependencies": {
    "@owlmeans/api": "^0.2.0-alpha.1",
    "@owlmeans/auth": "^0.2.0-alpha.0",
    "@owlmeans/auth-common": "^0.2.0-alpha.1",
    "@owlmeans/auth-token": "^0.2.0-alpha.1",
    "@owlmeans/basic-ids": "^0.2.0-alpha.0",
    "@owlmeans/client-config": "^0.2.0-alpha.1",
    "@owlmeans/client-context": "^0.2.0-alpha.1",
    "@owlmeans/client-entrypoint": "^0.2.0-alpha.1",
    "@owlmeans/client-planning": "^0.2.0-alpha.1",
    "@owlmeans/config": "^0.2.0-alpha.1",
    "@owlmeans/context": "^0.2.0-alpha.0",
    "@owlmeans/entrypoint": "^0.2.0-alpha.1",
    "@owlmeans/error": "^0.2.0-alpha.0",
    "@owlmeans/planning": "^0.2.0-alpha.1",
    "@owlmeans/route": "^0.2.0-alpha.1",
    "@owlmeans/socket": "^0.2.0-alpha.0",
    "@owlmeans/viable-common": "^0.2.0-alpha.2",
    "ajv": "^8.20.0",
    "fs-extra": "^11.4.1",
    "globby": "^16.2.4",
    "zod": "^4.6.7",
    "@owlmeans/client-upload": "^0.2.0-alpha.0",
    "@owlmeans/upload": "^0.2.0-alpha.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@owlmeans/dep-config": "^0.2.0-alpha.0",
    "@owlmeans/server-planning": "^0.2.0-alpha.1",
    "@types/bun": "^1.4.4",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
