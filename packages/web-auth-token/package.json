{
  "name": "@owlmeans/web-auth-token",
  "version": "0.1.18-rc.32",
  "license": "MIT",
  "description": "The browser half of long-lived access tokens (API keys) — the token management panel, its headless hook and its translations.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 384 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth-token": "^0.1.18-rc.31",
    "@owlmeans/client": "^0.1.18-rc.50",
    "@owlmeans/client-entrypoint": "^0.1.18-rc.46",
    "@owlmeans/client-i18n": "^0.1.18-rc.49",
    "@owlmeans/context": "^0.1.18-rc.33",
    "@owlmeans/entrypoint": "^0.1.18-rc.40",
    "@owlmeans/error": "^0.1.18-rc.37",
    "@owlmeans/i18n": "^0.1.18-rc.38"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": "*",
    "@radix-ui/react-label": "*",
    "@radix-ui/react-select": "*",
    "@radix-ui/react-slot": "*",
    "class-variance-authority": "*",
    "clsx": "*",
    "lucide-react": "*",
    "react": "*",
    "react-dom": "*",
    "tailwind-merge": "*",
    "tailwindcss": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "nodemon": "^3.1.14",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
