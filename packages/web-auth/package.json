{
  "name": "@owlmeans/web-auth",
  "version": "0.1.20-alpha.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 384 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./auth/plugins": {
      "import": "./build/auth/plugins/index.js",
      "require": "./build/auth/plugins/index.js",
      "default": "./build/auth/plugins/index.js",
      "module": "./build/auth/plugins/index.js",
      "types": "./build/auth/plugins/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth": "^0.1.19",
    "@owlmeans/auth-common": "0.1.20-alpha.0",
    "@owlmeans/basic-ids": "^0.1.19",
    "@owlmeans/basic-keys": "0.1.20-alpha.0",
    "@owlmeans/client": "0.1.20-alpha.0",
    "@owlmeans/client-auth": "0.1.20-alpha.0",
    "@owlmeans/client-flow": "0.1.20-alpha.0",
    "@owlmeans/config": "^0.1.19",
    "@owlmeans/context": "^0.1.19",
    "@owlmeans/log": "0.1.20-alpha.0",
    "@owlmeans/web-client": "0.1.20-alpha.0"
  },
  "peerDependencies": {
    "react": "*"
  },
  "devDependencies": {
    "@owlmeans/api": "0.1.20-alpha.0",
    "@owlmeans/dep-config": "^0.1.19",
    "@owlmeans/error": "^0.1.19",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "nodemon": "^3.1.14",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
