{
  "name": "@owlmeans/web-auth",
  "version": "0.2.0-alpha.1",
  "license": "MIT",
  "homepage": "https://owlmeans.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlmeans/common.git",
    "directory": "packages/web-auth"
  },
  "bugs": {
    "url": "https://github.com/owlmeans/common/issues"
  },
  "author": "Igor Tkachenko <igor.tkachenko@owlmeans.com> (https://owlmeans.com)",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 384 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./auth/plugins": {
      "import": "./build/auth/plugins/index.js",
      "require": "./build/auth/plugins/index.js",
      "default": "./build/auth/plugins/index.js",
      "module": "./build/auth/plugins/index.js",
      "types": "./build/auth/plugins/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth": "^0.2.0-alpha.0",
    "@owlmeans/auth-common": "^0.2.0-alpha.1",
    "@owlmeans/basic-ids": "^0.2.0-alpha.0",
    "@owlmeans/basic-keys": "^0.2.0-alpha.1",
    "@owlmeans/client": "^0.2.0-alpha.1",
    "@owlmeans/client-auth": "^0.2.0-alpha.1",
    "@owlmeans/client-flow": "^0.2.0-alpha.1",
    "@owlmeans/config": "^0.2.0-alpha.1",
    "@owlmeans/context": "^0.2.0-alpha.0",
    "@owlmeans/log": "^0.2.0-alpha.0",
    "@owlmeans/web-client": "^0.2.0-alpha.1"
  },
  "peerDependencies": {
    "react": "*"
  },
  "devDependencies": {
    "@owlmeans/api": "^0.2.0-alpha.1",
    "@owlmeans/dep-config": "^0.2.0-alpha.0",
    "@owlmeans/error": "^0.2.0-alpha.0",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "nodemon": "^3.1.14",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
