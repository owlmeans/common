{
  "name": "@owlmeans/web-bot",
  "version": "0.1.18-rc.4",
  "license": "MIT",
  "description": "The browser half of OwlMeans chat bots — shadcn panels for bot connections and activity, their hooks over a bound @owlmeans/bot protocol tree, and their translations.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 2 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/bot": "^0.1.18-rc.3",
    "@owlmeans/client": "^0.1.18-rc.59",
    "@owlmeans/client-entrypoint": "^0.1.18-rc.54",
    "@owlmeans/client-i18n": "^0.1.18-rc.58",
    "@owlmeans/entrypoint": "^0.1.18-rc.42",
    "@owlmeans/error": "^0.1.18-rc.39",
    "@owlmeans/i18n": "^0.1.18-rc.40",
    "@owlmeans/log": "^0.1.18-rc.4"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": "*",
    "@radix-ui/react-label": "*",
    "@radix-ui/react-select": "*",
    "@radix-ui/react-slot": "*",
    "class-variance-authority": "*",
    "clsx": "*",
    "lucide-react": "*",
    "react": "*",
    "react-dom": "*",
    "tailwind-merge": "*",
    "tailwindcss": "*"
  },
  "devDependencies": {
    "@owlmeans/config": "^0.1.18-rc.45",
    "@owlmeans/client-context": "^0.1.18-rc.55",
    "@owlmeans/context": "^0.1.18-rc.35",
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/route": "^0.1.18-rc.36",
    "@owlmeans/test-ui": "^0.1.18-rc.57",
    "@owlmeans/web-client": "^0.1.18-rc.70",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "nodemon": "^3.1.14",
    "playwright": "^1.63.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
