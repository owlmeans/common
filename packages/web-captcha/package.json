{
  "name": "@owlmeans/web-captcha",
  "version": "0.1.20-rc.1",
  "license": "MIT",
  "description": "Browser half of OwlMeans captcha — the invisible score-based reCAPTCHA v3 loader and a React hook; no OwlMeans dependencies.",
  "homepage": "https://owlmeans.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlmeans/common.git",
    "directory": "packages/web-captcha"
  },
  "bugs": {
    "url": "https://github.com/owlmeans/common/issues"
  },
  "author": "Igor Tkachenko <igor.tkachenko@owlmeans.com> (https://owlmeans.com)",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 2 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./react": {
      "import": "./build/react.js",
      "require": "./build/react.js",
      "default": "./build/react.js",
      "module": "./build/react.js",
      "types": "./build/react.d.ts"
    }
  },
  "peerDependencies": {
    "react": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@owlmeans/dep-config": "^0.1.20-rc.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
