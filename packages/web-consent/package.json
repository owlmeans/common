{
  "name": "@owlmeans/web-consent",
  "version": "0.1.18-rc.4",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 2 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/consent": "^0.1.18-rc.3"
  },
  "peerDependencies": {
    "clsx": "*",
    "lucide-react": "*",
    "react": "*",
    "tailwind-merge": "*",
    "tailwindcss": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test-ui": "^0.1.18-rc.11",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.550.0",
    "nodemon": "^3.1.14",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
