{
  "name": "@owlmeans/web-oauth",
  "version": "0.1.18-rc.20",
  "license": "MIT",
  "description": "The browser half of @owlmeans/oauth — the consent, device-code and done screens an OAuth 2.1 sign-in ends on, driven by the shared consent flow, plus the entrypoints and app-config helper that put them on a web app with no wiring beyond configuration.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 2 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth-common": "^0.1.18-rc.46",
    "@owlmeans/client": "^0.1.18-rc.50",
    "@owlmeans/client-auth": "^0.1.18-rc.57",
    "@owlmeans/client-context": "^0.1.18-rc.47",
    "@owlmeans/client-entrypoint": "^0.1.18-rc.46",
    "@owlmeans/client-flow": "^0.1.18-rc.53",
    "@owlmeans/client-i18n": "^0.1.18-rc.49",
    "@owlmeans/context": "^0.1.18-rc.33",
    "@owlmeans/entrypoint": "^0.1.18-rc.40",
    "@owlmeans/error": "^0.1.18-rc.37",
    "@owlmeans/flow": "^0.1.18-rc.44",
    "@owlmeans/i18n": "^0.1.18-rc.38",
    "@owlmeans/oauth": "^0.1.18-rc.15",
    "@owlmeans/route": "^0.1.18-rc.34"
  },
  "peerDependencies": {
    "@radix-ui/react-label": "*",
    "@radix-ui/react-slot": "*",
    "class-variance-authority": "*",
    "clsx": "*",
    "react": "*",
    "react-dom": "*",
    "tailwind-merge": "*",
    "tailwindcss": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test-auth": "^0.1.18-rc.45",
    "@owlmeans/test-ui": "^0.1.18-rc.48",
    "@owlmeans/web-client": "^0.1.18-rc.60",
    "@owlmeans/web-flow": "^0.1.18-rc.52",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "nodemon": "^3.1.14",
    "playwright": "^1.63.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
