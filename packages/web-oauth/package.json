    "tailwindcss": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "^0.1.21",
    "@owlmeans/test-auth": "^0.1.22-rc.0",
    "@owlmeans/test-ui": "^0.1.22-rc.0",
    "@owlmeans/web-client": "^0.1.22-rc.0",
    "@owlmeans/web-flow": "^0.1.22-rc.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
