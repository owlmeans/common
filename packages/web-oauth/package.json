{
  "name": "@owlmeans/web-oauth",
  "version": "0.1.22-rc.0",
  "license": "MIT",
  "description": "The browser half of @owlmeans/oauth — the consent, device-code and done screens an OAuth 2.1 sign-in ends on, driven by the shared consent flow, plus the entrypoints and app-config helper that put them on a web app with no wiring beyond configuration.",
  "homepage": "https://owlmeans.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlmeans/common.git",
    "directory": "packages/web-oauth"
  },
  "bugs": {
    "url": "https://github.com/owlmeans/common/issues"
  },
  "author": "Igor Tkachenko <igor.tkachenko@owlmeans.com> (https://owlmeans.com)",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 2 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth-common": "^0.1.22-rc.0",
    "@owlmeans/client": "^0.1.22-rc.0",
    "@owlmeans/client-auth": "^0.1.22-rc.0",
    "@owlmeans/client-context": "^0.1.22-rc.0",
    "@owlmeans/client-entrypoint": "^0.1.22-rc.0",
    "@owlmeans/client-flow": "^0.1.22-rc.0",
    "@owlmeans/client-i18n": "^0.1.22-rc.0",
    "@owlmeans/context": "^0.1.21",
    "@owlmeans/entrypoint": "^0.1.22-rc.0",
    "@owlmeans/error": "^0.1.21",
    "@owlmeans/flow": "^0.1.22-rc.0",
    "@owlmeans/i18n": "^0.1.21",
    "@owlmeans/oauth": "^0.1.22-rc.0",
    "@owlmeans/route": "^0.1.22-rc.0"
  },
  "peerDependencies": {
    "@radix-ui/react-label": "*",
