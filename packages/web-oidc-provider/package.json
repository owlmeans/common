{
  "name": "@owlmeans/web-oidc-provider",
  "version": "0.1.18-rc.4",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 372 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth": "^0.1.18-rc.4",
    "@owlmeans/client-flow": "^0.1.18-rc.4",
    "@owlmeans/oidc": "^0.1.18-rc.4",
    "@owlmeans/resource": "^0.1.18-rc.4",
    "@owlmeans/web-client": "^0.1.18-rc.4",
    "universal-cookie": "^7.2.1"
  },
  "peerDependencies": {
    "react": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@types/react": "^19.2.17",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
