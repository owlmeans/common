{
  "name": "@owlmeans/web-oidc-rp",
  "version": "0.1.4",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 378 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./auth/plugins": {
      "import": "./build/auth/plugins/index.js",
      "require": "./build/auth/plugins/index.js",
      "default": "./build/auth/plugins/index.js",
      "module": "./build/auth/plugins/index.js",
      "types": "./build/auth/plugins/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/auth": "^0.1.4",
    "@owlmeans/basic-envelope": "^0.1.4",
    "@owlmeans/client": "^0.1.4",
    "@owlmeans/client-auth": "^0.1.4",
    "@owlmeans/client-flow": "^0.1.4",
    "@owlmeans/client-i18n": "^0.1.4",
    "@owlmeans/context": "^0.1.4",
    "@owlmeans/flow": "^0.1.4",
    "@owlmeans/entrypoint": "^0.1.4",
    "@owlmeans/oidc": "^0.1.4",
    "@owlmeans/resource": "^0.1.4",
    "@owlmeans/web-client": "^0.1.4",
    "@owlmeans/web-flow": "^0.1.4",
    "oidc-client-ts": "3.5.0"
  },
  "peerDependencies": {
    "@radix-ui/react-progress": "^1.*",
    "class-variance-authority": "^0.7.*",
    "clsx": "^2.*",
    "lucide-react": ">=0.500.0",
    "react": "*",
    "react-router": "^7.*",
    "tailwind-merge": "^3.*",
    "tailwindcss": "^4.*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test-auth": "^0.1.4",
    "@owlmeans/test-ui": "^0.1.4",
    "@radix-ui/react-progress": "^1.1.7",
    "@tailwindcss/vite": "^4.1.16",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.7",
    "@vitejs/plugin-react": "^5.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "nodemon": "^3.1.11",
    "npm-check": "^6.0.1",
    "playwright": "^1.50.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^6.0.2",
    "vite": "^7.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
