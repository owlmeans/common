{
  "name": "@owlmeans/web-panel",
  "version": "0.1.15",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 384 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./auth": {
      "import": "./build/auth/index.js",
      "require": "./build/auth/index.js",
      "default": "./build/auth/index.js",
      "module": "./build/auth/index.js",
      "types": "./build/auth/index.d.ts"
    },
    "./auth/modules": {
      "import": "./build/auth/modules.js",
      "require": "./build/auth/modules.js",
      "default": "./build/auth/modules.js",
      "module": "./build/auth/modules.js",
      "types": "./build/auth/modules.d.ts"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@owlmeans/api-config-client": "^0.1.15",
    "@owlmeans/auth": "^0.1.15",
    "@owlmeans/auth-common": "^0.1.15",
    "@owlmeans/basic-envelope": "^0.1.15",
    "@owlmeans/client": "^0.1.15",
    "@owlmeans/client-auth": "^0.1.15",
    "@owlmeans/client-config": "^0.1.15",
    "@owlmeans/client-context": "^0.1.15",
    "@owlmeans/client-flow": "^0.1.15",
    "@owlmeans/client-i18n": "^0.1.15",
    "@owlmeans/client-entrypoint": "^0.1.15",
    "@owlmeans/client-panel": "^0.1.15",
    "@owlmeans/client-route": "^0.1.15",
    "@owlmeans/config": "^0.1.15",
    "@owlmeans/context": "^0.1.15",
    "@owlmeans/error": "^0.1.15",
    "@owlmeans/flow": "^0.1.15",
    "@owlmeans/i18n": "^0.1.15",
    "@owlmeans/entrypoint": "^0.1.15",
    "@owlmeans/route": "^0.1.15",
    "@owlmeans/web-client": "^0.1.15",
    "@owlmeans/web-db": "^0.1.15",
    "@owlmeans/web-flow": "^0.1.15",
    "@owlmeans/web-router": "^0.1.15",
    "i18next-browser-languagedetector": "^8.0.0",
    "qrcode.react": "^4.2.0",
    "react-google-recaptcha": "^3.1.0"
  },
  "peerDependencies": {
    "@radix-ui/react-label": "*",
    "@radix-ui/react-progress": "*",
    "@radix-ui/react-separator": "*",
    "@radix-ui/react-slot": "*",
    "ajv": "*",
    "class-variance-authority": "*",
    "clsx": "*",
    "lucide-react": "*",
    "react": "*",
    "react-dom": "*",
    "react-hook-form": "*",
    "tailwind-merge": "*",
    "tailwindcss": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test-ui": "^0.1.15",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-google-recaptcha": "^2.1.9",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.460.0",
    "nodemon": "^3.1.14",
    "playwright": "^1.49.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
