{
  "name": "@owlmeans/web-payment",
  "version": "0.1.18-rc.3",
  "license": "MIT",
  "description": "Protocol-bound payment hooks and themed amount checkout UI for OwlMeans web applications.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 384 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/client-i18n": "^0.1.18-rc.22",
    "@owlmeans/client-payment": "^0.1.18-rc.27",
    "@owlmeans/entrypoint": "^0.1.18-rc.18",
    "@owlmeans/i18n": "^0.1.18-rc.14",
    "@owlmeans/payment": "^0.1.18-rc.20"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": "*",
    "@radix-ui/react-label": "*",
    "@radix-ui/react-slot": "*",
    "class-variance-authority": "*",
    "clsx": "*",
    "react": "*",
    "react-dom": "*",
    "tailwind-merge": "*",
    "tailwindcss": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "workspace:*",
    "@owlmeans/test-ui": "^0.1.18-rc.22",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "nodemon": "^3.1.14",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
