{
  "name": "@owlmeans/web-payment",
  "version": "0.1.20-rc.1",
  "license": "MIT",
  "description": "Protocol-bound payment hooks and themed amount checkout UI for OwlMeans web applications.",
  "homepage": "https://owlmeans.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlmeans/common.git",
    "directory": "packages/web-payment"
  },
  "bugs": {
    "url": "https://github.com/owlmeans/common/issues"
  },
  "author": "Igor Tkachenko <igor.tkachenko@owlmeans.com> (https://owlmeans.com)",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 384 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./consumer": {
      "import": "./build/consumer/index.js",
      "require": "./build/consumer/index.js",
      "default": "./build/consumer/index.js",
      "module": "./build/consumer/index.js",
      "types": "./build/consumer/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/api": "^0.1.20-rc.1",
    "@owlmeans/client-i18n": "^0.1.20-rc.1",
    "@owlmeans/client-payment": "^0.1.20-rc.1",
    "@owlmeans/entrypoint": "^0.1.20-rc.1",
    "@owlmeans/error": "^0.1.20-rc.1",
    "@owlmeans/i18n": "^0.1.20-rc.1",
    "@owlmeans/payment": "^0.1.20-rc.1"
  },
  "peerDependencies": {
    "@radix-ui/react-checkbox": "*",
    "@radix-ui/react-dialog": "*",
    "@radix-ui/react-label": "*",
    "@radix-ui/react-progress": "*",
    "@radix-ui/react-select": "*",
    "@radix-ui/react-slot": "*",
    "class-variance-authority": "*",
    "clsx": "*",
    "react": "*",
    "react-dom": "*",
    "tailwind-merge": "*",
    "tailwindcss": "*"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "^0.1.20-rc.1",
    "@owlmeans/test-ui": "^0.1.20-rc.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nodemon": "^3.1.14",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
