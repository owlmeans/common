{
  "name": "@owlmeans/web-router-react-router",
  "version": "0.1.19",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 63 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "peerDependencies": {
    "react": "*",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "^0.1.19",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "nodemon": "^3.1.14",
    "react-router": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@owlmeans/context": "^0.1.19",
    "@owlmeans/router": "^0.1.19"
  },
  "publishConfig": {
    "access": "public"
  }
}
